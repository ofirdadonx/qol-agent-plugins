{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inbox-items.schema.json",
  "title": "Inbox items whose destination or category is not yet clear",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Path under sources/ after the item was archived."
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "added_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "added_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "raw_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "destination_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "food, sights, shopping, daytrips, or null if unknown."
          },
          "name": {
            "type": [
              "object",
              "string",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
