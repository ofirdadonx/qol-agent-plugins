{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip.schema.json",
  "title": "Trip",
  "type": "object",
  "required": [
    "title",
    "dates",
    "travelers",
    "currency",
    "fx",
    "language",
    "dir",
    "destinations"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "kicker": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "dates": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "flexible": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when start/end are a provisional window, not a fixed booking."
        },
        "approx_nights": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Intended length in nights when dates are flexible or a range is still open."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "departure_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "return_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "home_airport": {
      "type": "string"
    },
    "home_tz": {
      "type": "string"
    },
    "travelers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "passport": {
            "type": "string",
            "description": "Issuing country only, never a passport number."
          },
          "dietary": {
            "description": "This traveler's dietary restrictions. An array of short tags and/or free-text strings, or a single free-text string. Place diet_fit is checked against the union of all travelers. Omit or leave empty if none.",
            "type": [
              "array",
              "string",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "booking_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name as it should appear on tickets and reservations, if different from name."
          },
          "age": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Age at the time of the trip, if known. Useful for child fares and entry rules."
          },
          "child": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True if this traveler is a child for booking and entry purposes."
          },
          "allergies": {
            "type": [
              "array",
              "string",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Allergies for this traveler. Dietary restrictions belong in dietary."
          },
          "accessibility": {
            "type": [
              "string",
              "null"
            ],
            "description": "Mobility or accessibility needs for this traveler."
          },
          "medical": {
            "type": [
              "string",
              "null"
            ],
            "description": "Medical notes that affect the trip. No diagnosis secrets required; write only what the page and bookings need."
          },
          "gear": {
            "type": [
              "string",
              "null"
            ],
            "description": "Special gear this traveler needs (for example a CPAP, or a child car seat)."
          }
        }
      }
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "fx": {
      "type": "object",
      "required": [
        "date",
        "rates_to_home"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "rates_to_home": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Units of the trip's home currency per 1 unit of the key currency. The home currency itself should be 1."
        },
        "cross_rates": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Optional pair rates for display, keyed by pair code (e.g. USDEUR)."
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "language": {
      "type": "string"
    },
    "dir": {
      "type": "string",
      "enum": [
        "rtl",
        "ltr"
      ]
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "country",
          "dates"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "country": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "object",
            "minProperties": 1,
            "description": "Localized strings. Keys are language codes (en, pt, he, …) and optionally 'local' for a local-script form. Include at least the trip's language; 'en' is a useful fallback.",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "dates": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              },
              "flexible": {
                "type": "boolean"
              }
            }
          },
          "nights": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "nights_min": {
            "type": [
              "integer",
              "null"
            ]
          },
          "nights_max": {
            "type": [
              "integer",
              "null"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "icon": {
            "type": "string"
          },
          "coords": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "exact": {
                "type": "boolean"
              }
            },
            "required": [
              "lat",
              "lng"
            ],
            "additionalProperties": false
          },
          "certainty": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "sure",
              "open",
              null
            ],
            "description": "sure = this stop is decided; open = still being chosen. Open stops are often also marked optional."
          },
          "summary_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Short note under the destination-card summary (for example why a stop is still optional)."
          },
          "optional_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Override the optional badge text on this stop."
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "href",
          "label"
        ],
        "properties": {
          "href": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        }
      }
    },
    "shared_docs": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "shared_packing": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "overview_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "map": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "tile_url": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "fallback_svg": {
          "type": "string",
          "description": "Path relative to the data folder"
        }
      }
    },
    "nights_chart_caption": {
      "type": "string"
    },
    "status_legend": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dietary_note": {
      "type": "string",
      "description": "Optional free-text note about the party's combined diet, shown on the page. Structured restrictions belong on travelers[].dietary."
    },
    "id": {
      "type": "string",
      "description": "Stable trip id, used as a default storage key prefix."
    },
    "storage_key": {
      "type": "string",
      "description": "localStorage key prefix for theme and on-device choices."
    },
    "locale": {
      "type": "string",
      "description": "BCP 47 locale for number formatting (defaults to language)."
    },
    "countdown": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional override strings for the departure countdown. Placeholders: {hours}, {days}.",
      "properties": {
        "before": {
          "type": "string"
        },
        "before_one": {
          "type": "string"
        },
        "before_soon": {
          "type": "string"
        },
        "during": {
          "type": "string"
        },
        "during_short": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable line above the countdown number (for example a formatted departure date). If omitted, the page formats departure_at."
        }
      }
    },
    "nights_chart": {
      "type": "object",
      "description": "Optional grouping for the nights chart. If omitted, one bar is derived per destination.",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "y_max": {
          "type": "number"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "nights"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "description": "Axis label; a two-item array becomes a two-line label.",
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                }
              },
              "nights": {
                "type": "number"
              },
              "optional": {
                "type": "boolean"
              },
              "undecided": {
                "type": "boolean"
              },
              "region": {
                "type": "integer"
              },
              "color": {
                "type": "string",
                "description": "CSS variable name without --, e.g. warn, accent, region-0."
              },
              "tooltip": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "departure_city": {
      "type": [
        "string",
        "null"
      ],
      "description": "City the party leaves from. home_airport holds the IATA code when known."
    },
    "trip_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text type, for example honeymoon, family, backpacking, work+leisure, city-break, road-trip."
    },
    "budget_plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Intended spend, set at onboarding. Distinct from the booked-only budget derived from bookings.json.",
      "properties": {
        "total": {
          "type": [
            "number",
            "null"
          ],
          "description": "Overall budget in the given currency, if known."
        },
        "level": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "budget",
            "mid",
            "luxury",
            null
          ],
          "description": "Rough level when a total is not set."
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3,
          "maxLength": 3
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "already_booked_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Free-text summary of what is already booked. Structured items belong in bookings.json; confirmations can be dropped into inbox/."
    },
    "preferences": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Optional. Can be filled after the skeleton exists.",
      "properties": {
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered preferences, for example food, culture, nature, shopping, nightlife, rest."
        },
        "pace": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": [
                "string",
                "null"
              ],
              "description": "For example many_stops or few_in_depth."
            },
            "hotel_changes": {
              "type": [
                "string",
                "null"
              ],
              "description": "How often the party is willing to change hotels."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "lodging": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Preferred kinds, for example hotel, apartment, ryokan, boutique."
            },
            "bed": {
              "type": [
                "string",
                "null"
              ],
              "description": "For example double, twin, or family room."
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "transport": {
          "type": [
            "object",
            "string",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "rental_car": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "international_license": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether an international driving permit is needed or already held."
            },
            "trains": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "taxis_only": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "accessibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "medical": {
          "type": [
            "string",
            "null"
          ]
        },
        "gear": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "entry_checks": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Filled by the model from passports and destinations (not by init_trip). Visa and entry rules, passport validity, insurance, power adapters, and problem dates such as local holidays or high season. Cite sources in the notes; do not invent.",
      "properties": {
        "visa": {
          "type": [
            "string",
            "null"
          ]
        },
        "passport_validity": {
          "type": [
            "string",
            "null"
          ]
        },
        "insurance": {
          "type": [
            "string",
            "null"
          ]
        },
        "power_adapters": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem_dates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "dates": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A range or month when a single date does not apply."
              },
              "place": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "note"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
