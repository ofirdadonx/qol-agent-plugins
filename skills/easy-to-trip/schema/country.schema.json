{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "country.schema.json",
  "title": "Country-level practical info",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "object",
      "minProperties": 1,
      "description": "Localized strings. Keys are language codes (en, pt, he, …) and optionally 'local' for a local-script form. Include at least the trip's language; 'en' is a useful fallback.",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "badge": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "utc_offset": {
      "type": "string"
    },
    "hours_ahead_of_home": {
      "type": [
        "number",
        "null"
      ]
    },
    "currency": {
      "type": "string"
    },
    "practical_headline": {
      "type": "string"
    },
    "practical_lede": {
      "type": "string"
    },
    "practical": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "body"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "html": {
            "type": "boolean"
          }
        }
      }
    },
    "emergency": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "number"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "tel": {
            "type": "string"
          }
        }
      }
    },
    "embassy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "phone_emergency": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "entry_docs": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "packing": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "callout": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "climate": {
      "type": "string"
    },
    "transport_notes": {
      "type": "string"
    },
    "timeline_headline": {
      "type": "string",
      "description": "Headline for the country timeline section"
    },
    "timeline_lede": {
      "type": "string",
      "description": "Lede under that headline"
    },
    "act_label": {
      "type": "string",
      "description": "Small act label, e.g. Portugal · 3 nights"
    },
    "journal_headline": {
      "type": "string",
      "description": "Day-journal headline"
    },
    "journal_lede": {
      "type": "string",
      "description": "Day-journal lede"
    },
    "journal_act": {
      "type": "string",
      "description": "Day-journal act label"
    },
    "phrases": {
      "type": "object",
      "description": "Cards of short phrases to show (dietary requests, allergies, directions, greetings, etc.). Content is whatever this trip needs, in the local language.",
      "properties": {
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "e.g. dietary, allergies, directions, greetings"
              },
              "label": {
                "type": "string"
              },
              "language_label": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "romanization": {
                      "type": "string"
                    },
                    "meaning": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "color": {
      "type": "string",
      "description": "Accent color for this country (CSS color). Used for the region rail, display type and mesh."
    },
    "color_2": {
      "type": "string",
      "description": "Secondary accent (CSS color)."
    },
    "accent": {
      "type": "string",
      "description": "Optional third accent, e.g. a gold for optional/dashed marks."
    },
    "tint": {
      "type": "string",
      "description": "Translucent tint of the accent (CSS color)."
    },
    "mesh": {
      "type": "string",
      "description": "Mesh-wash color for the page background (CSS color, typically translucent)."
    },
    "flag": {
      "type": "object",
      "description": "Inline SVG flag, drawn from simple shapes. Off-white fills should use a grey such as #efece6, never pure #fff.",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Accessible name, e.g. Flag of Japan."
        },
        "shapes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "rect",
                  "circle",
                  "stripe",
                  "path"
                ]
              },
              "fill": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "cx": {
                "type": "number"
              },
              "cy": {
                "type": "number"
              },
              "r": {
                "type": "number"
              },
              "d": {
                "type": "string",
                "description": "SVG path data when type is path."
              }
            }
          }
        }
      }
    }
  }
}
