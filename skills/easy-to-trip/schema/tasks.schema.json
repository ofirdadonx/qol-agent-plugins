{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tasks.schema.json",
  "type": "object",
  "required": [
    "done",
    "open"
  ],
  "additionalProperties": false,
  "properties": {
    "headline": {
      "type": "string"
    },
    "lede": {
      "type": "string"
    },
    "done": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "booking_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "booking_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
